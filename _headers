# Netlify header rules.
#
# The document and the service worker MUST NOT be cached by the CDN or the
# browser. If they are, a deploy does not reach phones — which is the exact
# problem that made us leave HtmlService. Everything else is content-addressed
# enough to cache hard.

# no-cache, NOT no-store. The two are often confused and the difference is the
# whole point here:
#   no-store  = the browser may not keep a copy at all, so all 235KB of the app
#               is downloaded again on every single launch.
#   no-cache  = the browser may keep a copy but must ASK before using it. If the
#               file has not changed it gets a 304 and reuses what it has.
# The freshness guarantee is identical — nothing stale can ever be used without
# checking — but an unchanged deploy now costs one small request instead of
# 235KB. This does not weaken the reason we left HtmlService.
/index.html
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/config.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=604800
